<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <Configurations>2020;2021;2022;2023;2024;2025;2026</Configurations>
    <Platforms>x64</Platforms>
    <Configuration Condition=" '$(Configuration)' == '' ">2023</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>NU1605</NoWarn>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Configuration names start with a digit (2020/.../2025) so the SDK's
         implicit "/define:$(Configuration)" would emit an invalid C# identifier. -->
    <DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
  </PropertyGroup>

  <!-- Per-Tekla-version values derived from $(Configuration) ("2020"..."2025") -->
  <PropertyGroup>
    <OutputPath>bin\$(Configuration)\x64\</OutputPath>
    <DefineConstants>TEKLA$(Configuration)</DefineConstants>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.6.5" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="FluentAssertions" Version="8.4.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Tekla.Structures.All version follows the configuration year (2020.0.1 ... 2025.0.1) -->
  <ItemGroup>
    <PackageReference Include="Tekla.Structures.All" Version="$(Configuration).*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tekla.Extension\Tekla.Extension.csproj" />
  </ItemGroup>

</Project>
