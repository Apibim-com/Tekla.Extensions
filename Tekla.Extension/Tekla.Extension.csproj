  <Target Name="SignAssemblyWithAuthenticode" AfterTargets="Build" Condition="'$(SignWithAuthenticode)' == 'true' AND Exists('$(CertificateFile)')">
    <PropertyGroup>
      <SignToolPath Condition="'$(SignToolPath)' == '' AND Exists('C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe')">C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe</SignToolPath>
