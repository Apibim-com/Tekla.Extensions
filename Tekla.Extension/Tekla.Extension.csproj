<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Configurations>2020;2021;2022;2023;2024;2025</Configurations>
    <Platforms>x64</Platforms>
    <Configuration Condition=" '$(Configuration)' == '' ">2023</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Tekla.Extension</RootNamespace>
    <AssemblyName>Tekla.Extension</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Configuration names start with a digit (2020/2021/.../2025) so the SDK's
         implicit "/define:$(Configuration)" would emit an invalid C# identifier. -->
    <DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
  </PropertyGroup>

  <!-- Assembly metadata (auto-emitted as attributes by the SDK) -->
  <PropertyGroup>
    <AssemblyTitle>Tekla.Extensions</AssemblyTitle>
    <Product>Apibim Tekla Extensions</Product>
    <Company>Apibim SpA</Company>
    <Copyright>Copyright © Apibim SpA 2025</Copyright>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <PackageId>Tekla.Extension</PackageId>
    <Authors>Yury Isachenkov</Authors>
    <PackageProjectUrl>https://github.com/Apibim-com/Tekla.Extensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Apibim-com/Tekla.Extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <Description>Unofficial extension library for Tekla Structures Open API. Provides LINQ-compatible extension methods to simplify working with Tekla models — cleaner, more readable C# code without boilerplate enumerator loops.</Description>
    <PackageReleaseNotes>More methods and features</PackageReleaseNotes>
    <PackageTags>Tekla;TeklaStructures;OpenAPI;BIM;Trimble;LINQ;Extensions</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- Non-version-controlled assembly attributes (the rest are emitted from the properties above) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyTrademarkAttribute">
      <_Parameter1>Apibim®</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>03c19a66-26c8-4572-a784-e0f59e513cd1</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Per-Tekla-version values derived from $(Configuration) ("2020"..."2025") -->
  <PropertyGroup>
    <OutputPath>bin\$(Configuration)\x64\</OutputPath>
    <PackageOutputPath>bin\$(Configuration)\x64\</PackageOutputPath>
    <DefineConstants>TRACE;TEKLA$(Configuration)</DefineConstants>
    <DocumentationFile>bin\$(Configuration)\x64\Tekla.Extension.xml</DocumentationFile>
    <Version>$(Configuration).0.3</Version>
    <Optimize>true</Optimize>
    <DebugType>pdbonly</DebugType>
    <ErrorReport>prompt</ErrorReport>
  </PropertyGroup>

  <!-- .NET Framework references not included by default in the SDK -->
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Runtime.Remoting" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Net.Http" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <!-- Package content -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Tekla.Structures.All version follows the configuration year (2020.0.1 ... 2025.0.1) -->
  <ItemGroup>
    <PackageReference Include="Tekla.Structures.All" Version="$(Configuration).0.1" />
  </ItemGroup>

  <!-- Authenticode Signing Target -->
  <Target Name="SignAssemblyWithAuthenticode" AfterTargets="Build" Condition="'$(SignWithAuthenticode)' == 'true' AND Exists('$(CertificateFile)')">
    <PropertyGroup>
      <SignToolPath Condition="'$(SignToolPath)' == '' AND Exists('C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe')">C:\Program Files (x86)\Windows Kits\10\bin\10.0.22621.0\x64\signtool.exe</SignToolPath>
      <SignToolPath Condition="'$(SignToolPath)' == '' AND Exists('C:\Program Files (x86)\Windows Kits\10\bin\10.0.19041.0\x64\signtool.exe')">C:\Program Files (x86)\Windows Kits\10\bin\10.0.19041.0\x64\signtool.exe</SignToolPath>
      <SignToolPath Condition="'$(SignToolPath)' == '' AND Exists('C:\Program Files (x86)\Windows Kits\10\bin\10.0.18362.0\x64\signtool.exe')">C:\Program Files (x86)\Windows Kits\10\bin\10.0.18362.0\x64\signtool.exe</SignToolPath>
    </PropertyGroup>
    <Message Text="Signing assembly with Authenticode..." Importance="high" />
    <Message Text="Certificate: $(CertificateFile)" Importance="high" />
    <Message Text="Assembly: $(TargetPath)" Importance="high" />
    <Exec Command="&quot;$(SignToolPath)&quot; sign /f &quot;$(CertificateFile)&quot; /p &quot;$(CertificatePassword)&quot; /t &quot;$(TimestampServer)&quot; /fd SHA256 /v &quot;$(TargetPath)&quot;" Condition="'$(SignToolPath)' != '' AND '$(CertificatePassword)' != ''" ContinueOnError="false" />
    <Exec Command="&quot;$(SignToolPath)&quot; sign /f &quot;$(CertificateFile)&quot; /t &quot;$(TimestampServer)&quot; /fd SHA256 /v &quot;$(TargetPath)&quot;" Condition="'$(SignToolPath)' != '' AND '$(CertificatePassword)' == ''" ContinueOnError="false" />
    <Warning Text="SignTool.exe not found. Please install Windows SDK to enable code signing." Condition="'$(SignToolPath)' == ''" />
    <Message Text="Assembly signed successfully!" Importance="high" Condition="'$(SignToolPath)' != ''" />
  </Target>

</Project>
